APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://streamchat:password@postgres:5432/streamchat?sslmode=disable
REDIS_ADDR=redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
YTDLP_BINARY=yt-dlp
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_MAX_SIZE_MB=200
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_HEIGHT=720
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=300
MEDIA_WORKER_CONCURRENCY=2
MEDIA_EGRESS_PROXY=
MEDIA_TEMP_DIR=/tmp/streamchat-media
LOCAL_STORAGE_ROOT=./data
